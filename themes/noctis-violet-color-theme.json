  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "unused.comment",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#61577D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation Comments Keywords",
      "scope": [
        "comment.block.documentation keyword",
        "comment.block.documentation storage.type.class"
      ],
      "settings": {
        "foreground": "#A855F7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#86EFAC"
      }
    },
    {
      "name": "String Interpolation & Escape",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#818CF8"
      }
    },
    {
      "name": "Numbers & Units",
      "scope": [
        "constant.numeric",
        "keyword.other.unit",
        "constant.numeric.decimal",
        "constant.numeric.hex",
        "constant.numeric.binary"
      ],
      "settings": {
        "foreground": "#FDE047"
      }
    },
    {
      "name": "Constants & Booleans",
      "scope": [
        "constant",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#F472B6"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.control.trycatch",
        "keyword.control.return"
      ],
      "settings": {
        "foreground": "#C084FC"
      }
    },
    {
      "name": "Storage & Modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.function",
        "storage.type.const",
        "storage.type.let",
        "storage.type.var",
        "storage.modifier",
        "storage.modifier.async"
      ],
      "settings": {
        "foreground": "#C084FC"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.assignment",
        "keyword.operator.ternary",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#D8B4FE"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "meta.method.declaration entity.name.function",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#A78BFA"
      }
    },
    {
      "name": "Built-in Functions",
      "scope": [
        "support.function.builtin",
        "support.function.console",
        "support.function.promise"
      ],
      "settings": {
        "foreground": "#A78BFA"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.type-parameter",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#D8B4FE"
      }
    },
    {
      "name": "Variables & Object Properties",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.object-literal.key",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#ECE8F5"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "parameters.variable"
      ],
      "settings": {
        "foreground": "#DDD8E8"
      }
    },
    {
      "name": "Language Constants & Special Variables",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.super",
        "variable.parameter.function.language.special.self",
        "variable.parameter.function.language.special.cls"
      ],
      "settings": {
        "foreground": "#F472B6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tags (HTML, JSX, XML)",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "punctuation.definition.tag",
        "entity.name.tag.html",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "entity.name.tag.xml"
      ],
      "settings": {
        "foreground": "#E879F9"
      }
    },
    {
      "name": "Attributes (HTML, JSX, XML)",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx",
        "entity.other.attribute-name.xml"
      ],
      "settings": {
        "foreground": "#C084FC"
      }
    },
    {
      "name": "JSON & YAML Keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#A78BFA"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.media.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#D8B4FE"
      }
    },
    {
      "name": "CSS Classes, IDs & Pseudo Elements",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#C084FC"
      }
    },
    {
      "name": "CSS Values & Units",
